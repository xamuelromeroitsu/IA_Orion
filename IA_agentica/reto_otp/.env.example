# ============================================================
# .env.example - PLANTILLA CON NOTAS (NO COPIAR VALORES REALES)
# ============================================================
# Usa este archivo como guía. Crea tu propio .env local y
# completa los valores según tu entorno. No pegues secretos
# reales en el repositorio.
# ============================================================

# --- API / Runtime ---
PORT=
TZ=
LOG_LEVEL=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- IA / Integraciones externas ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EXTRACTION_MODEL=
TAVILY_API_KEY=
BCV_SOURCE_URL=
BCV_FALLBACK_RATE=

# --- Seguridad / Reglas de app ---
AES_KEY=
MAX_PROPOSALS=
ALLOWED_MIME=
DEMO_MODE=
DEMO_USER_ID=

# --- Frontend (Vite) ---
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- React Bits Pro (solo local, apps/web/.env.local) ---
REACTBITS_LICENSE_KEY=
